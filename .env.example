# ── Pandu configuration ──────────────────────────────────────────────────────
# Copy to .env, add ONE provider API key, and `make up`.
# Model refs are "provider/model" strings; provider selects the adapter.

# App
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Persistence (compose service hostnames; use localhost for `make dev`)
DATABASE_URL=postgresql+asyncpg://pandu:pandu@localhost:5432/pandu
REDIS_URL=redis://localhost:6379/0

# Auth: comma-separated API keys clients must send as X-API-Key.
# Empty = auth disabled (dev only).
API_KEYS=dev-local-key
# Browser origins allowed to call the API (comma-separated):
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI models ────────────────────────────────────────────────────────────────
# Zero-key demo default: deterministic extractive mock (no provider account).
# For real generation set e.g. openai/gpt-4o-mini or deepseek/deepseek-v4-flash
# plus the matching provider key below.
AI_CHAT_MODEL=mock/extractive
# Ordered fallback when the primary provider errors (empty = none):
AI_FALLBACK_MODEL=
# DeepSeek has no embedding API — embeddings are configured independently.
# Keyless/offline option: hash/ngram (deterministic n-gram hashing — runs the
# full stack with no embedding credentials; not semantic, demo/CI quality):
AI_EMBED_MODEL=hash/ngram
# LLM-as-judge for evals (empty = reuse AI_CHAT_MODEL):
AI_JUDGE_MODEL=

# Provider credentials (only the providers you reference need keys)
# NOTE: OPENAI_API_KEY is also what the optional ragas suite needs — ragas'
# llm_factory targets OpenAI via langchain, so a non-OpenAI judge is skipped
# rather than scored (see backend/evals/ragas_runner.py).
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Any OpenAI-compatible endpoint (Ollama, vLLM, Groq, ...) via provider "compat":
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Retrieval pipeline ───────────────────────────────────────────────────────
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RRF_K=60
# Reranker: none | cohere | jina | local  (local needs `--extra rerank-local`)
RERANKER=none
COHERE_API_KEY=
JINA_API_KEY=
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Search index adapter behind the SearchIndex port (ADR-002).
#   pg     = Postgres pgvector + FTS (the default, and the measured baseline)
#   qdrant = optional Qdrant adapter, proven by the eval sweep, not deployed
#            by default. Self-hosted needs no API key, only a URL.
SEARCH_INDEX=pg
QDRANT_URL=http://localhost:6333
# Only for Qdrant Cloud; the local container needs no key:
QDRANT_API_KEY=

# ── Ingestion ────────────────────────────────────────────────────────────────
# Docling OCRs every PDF page by default; for text-layer PDFs (like the NIST
# corpus) that is pure cost for identical text. Enable for scanned sources.
DOCLING_OCR=false
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBED_BATCH_SIZE=64
MAX_UPLOAD_BYTES=26214400

# ── Observability (optional) ─────────────────────────────────────────────────
# `docker compose --profile observability up -d` starts a self-hosted Langfuse
# at http://localhost:3001, pre-provisioned with local-only demo keys
# (pk-lf-pandu-local / sk-lf-pandu-local — they authenticate against nothing
# but that local container). Set them here to enable tracing; empty = no-op
# tracer. Requires `uv sync --extra observability`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
