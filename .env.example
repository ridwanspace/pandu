# ── Pandu configuration ──────────────────────────────────────────────────────
# Copy to .env, add ONE provider API key, and `make up`.
# Model refs are "provider/model" strings; provider selects the adapter.

# App
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Persistence (compose service hostnames; use localhost for `make dev`)
DATABASE_URL=postgresql+asyncpg://pandu:pandu@localhost:5432/pandu
REDIS_URL=redis://localhost:6379/0

# Auth: comma-separated API keys clients must send as X-API-Key.
# Empty = auth disabled (dev only).
API_KEYS=dev-local-key
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI models ────────────────────────────────────────────────────────────────
AI_CHAT_MODEL=openai/gpt-4o-mini
# Ordered fallback when the primary provider errors (empty = none):
AI_FALLBACK_MODEL=deepseek/deepseek-chat
# DeepSeek has no embedding API — embeddings are configured independently.
# Keyless/offline option: hash/ngram (deterministic n-gram hashing — runs the
# full stack with no embedding credentials; not semantic, demo/CI quality):
AI_EMBED_MODEL=openai/text-embedding-3-small
# LLM-as-judge for evals (empty = reuse AI_CHAT_MODEL):
AI_JUDGE_MODEL=

# Provider credentials (only the providers you reference need keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Any OpenAI-compatible endpoint (Ollama, vLLM, Groq, ...) via provider "compat":
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Retrieval pipeline ───────────────────────────────────────────────────────
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RRF_K=60
# Reranker: none | cohere | jina | local  (local needs `--extra rerank-local`)
RERANKER=none
COHERE_API_KEY=
JINA_API_KEY=
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Ingestion ────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBED_BATCH_SIZE=64
MAX_UPLOAD_BYTES=26214400

# ── Observability (optional; compose --profile observability) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
